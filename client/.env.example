# SMTP server hostname
SMTP_HOST=

# SMTP port, commonly 587 for STARTTLS or 465 for SSL
SMTP_PORT=587

# SMTP username
SMTP_USER=

# SMTP password or provider-specific app password
SMTP_PASS=

# Destination mailbox for website enquiries
EMAIL_TO=

# Optional sender address used in outbound mail
EMAIL_FROM=
